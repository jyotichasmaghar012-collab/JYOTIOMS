# Optical Shop OMS - environment settings
# Ye file GitHub par upload NAHI hoti (.gitignore mein hai).

# Server port - browser mein http://localhost:<PORT> kholein
PORT=5000

# Login session ko sign karne ki secret key. Ise kisi ke saath share na karein.
# Badalne par sab users logout ho jayenge.
OMS_SECRET_KEY=change-me-to-a-long-random-string

# 1 = templates turant reload + error details screen par (sirf development ke liye)
DEBUG=0

# Database file ka path (khaali chhodein to data/oms.db use hogi)
# OMS_DB_PATH=data/oms.db
